---
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource/balsamiq-sans/latin-700.css';
import '@/styles/global.css';
import fontLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { routes, htmlLang, ogLocale, type Lang, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/config/site';
import { img } from '@/config/images';
import TopBar from '@/components/layout/TopBar.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Drawer from '@/components/layout/Drawer.astro';
import SearchDialog from '@/components/layout/SearchDialog.astro';
import VideoDialog from '@/components/ui/VideoDialog.astro';

interface Crumb { name: string; key: RouteKey }
interface Props {
  lang: Lang;
  routeKey: RouteKey | null;
  title: string;
  description: string;
  image?: ImageMetadata;
  /** Migas de pan para datos estructurados (además de Inicio). */
  crumbs?: Crumb[];
  /** JSON-LD adicional de la página. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, routeKey, title, description, image = img.fachadaPrincipal, crumbs = [], schema = [], noindex = false } = Astro.props;
const ui = t(lang);
const siteUrl = (Astro.site ?? new URL('https://kacademy.com.mx')).toString().replace(/\/$/, '');
const pathname = routeKey ? routes[routeKey][lang] : Astro.url.pathname;
const canonical = siteUrl + pathname;
const fullTitle = routeKey === 'home' ? title : `${title} | ${site.name}`;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, siteUrl + '/').toString();

const orgId = `${siteUrl}/#organization`;
const baseSchema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': ['School', 'EducationalOrganization'],
    '@id': orgId,
    name: site.name,
    legalName: site.legalName,
    url: siteUrl + '/',
    logo: siteUrl + '/brand/logo.svg',
    image: ogUrl,
    description: ui.footerAbout,
    telephone: '+52 442 434 7600',
    email: site.email,
    slogan: lang === 'es' ? 'Educamos la mente. Fortalecemos el cuerpo. Despertamos la conciencia.' : 'Educate to transcend',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      addressRegion: site.address.region,
      addressCountry: site.address.country,
    },
    sameAs: Object.values(site.social),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl + '/',
    name: site.name,
    inLanguage: htmlLang[lang],
    publisher: { '@id': orgId },
  },
];
if (routeKey && routeKey !== 'home') {
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.breadcrumbHome, item: siteUrl + routes.home[lang] },
      ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: siteUrl + routes[c.key][lang] })),
    ],
  });
}
const allSchema = [...baseSchema, ...schema];
---
<!doctype html>
<html lang={htmlLang[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {routeKey && (
      <>
        <link rel="alternate" hreflang="es-MX" href={siteUrl + routes[routeKey].es} />
        <link rel="alternate" hreflang="en" href={siteUrl + routes[routeKey].en} />
        <link rel="alternate" hreflang="x-default" href={siteUrl + routes[routeKey].es} />
      </>
    )}
    <meta name="theme-color" content="#1e3045" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'es' ? 'en' : 'es']} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@keyacademy26" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <TopBar lang={lang} routeKey={routeKey} />
    <Header lang={lang} routeKey={routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <Drawer lang={lang} routeKey={routeKey} />
    <SearchDialog lang={lang} />
    <VideoDialog closeLabel={ui.close} />
    <script>
      import '@/scripts/app';
      import '@/scripts/translate';
    </script>
  </body>
</html>

---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Statement from '@/components/ui/Statement.astro';
import Clouds from '@/components/ui/Clouds.astro';
import Pillars from '@/components/sections/Pillars.astro';
import Grades from '@/components/sections/Grades.astro';
import { img } from '@/config/images';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/routes';
import data from '@/data/kinder';
import kite1 from '@/assets/deco/nino-papalote-1.png';
import kite2 from '@/assets/deco/nino-papalote-2.png';
import capPurple from '@/assets/deco/birrete-morado.png';
import balloonImg from '@/assets/deco/globo-aerostatico.png';
import beeImg from '@/assets/deco/abeja.png';
import bookImg from '@/assets/deco/libro.png';
import stringImg from '@/assets/deco/globo-linea.png';
import cloudsImg from '@/assets/deco/nubes.png';
import tornImg from '@/assets/deco/borde-rasgado.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const ui = t(lang);
const howTones = ['sage', 'clay', 'sky', 'navy'];
const gradeImgs = [img.patioCentral, img.jardinJuegos, img.aulaKinder, img.aulaPrimaria];
const schema = [{
  '@context': 'https://schema.org', '@type': 'Course', name: d.meta.title, description: d.meta.description,
  provider: { '@type': 'School', name: 'Kensington Academy' }, inLanguage: ['es', 'en'], educationalLevel: 'Kindergarten',
}];
---
<Base lang={lang} routeKey="kinder" title={d.meta.title} description={d.meta.description} image={img.ninoKinder} crumbs={[{ name: ui.nav.kinder, key: 'kinder' }]} schema={schema}>
  <section class="khero" style={`--clouds:url(${cloudsImg.src});--torn:url(${tornImg.src})`}>
    <img class="kfloat kfloat--balloon" src={balloonImg.src} alt="" width="68" height="94" />
    <img class="kfloat kfloat--book" src={bookImg.src} alt="" width="119" height="100" />
    <img class="kfloat kfloat--string" src={stringImg.src} alt="" width="70" height="133" />
    <div class="kbee" aria-hidden="true"><img src={beeImg.src} alt="" width="107" height="107" /></div>
    <div class="container khero__in">
      <div class="khero__copy">
        <h1>
          <span class="khero__l">{d.hero.title[0]}</span>
          <span class="khero__l"><mark>{d.hero.title[1]}</mark> {d.hero.title[2]}</span>
          <span class="khero__l"><mark>{d.hero.title[3]}</mark></span>
        </h1>
        <p class="text-j">{d.hero.text}</p>
        <a class="kbtn" href="#como-aprenden">
          <span class="kbtn__label">{d.hero.cta}</span>
          <span class="kbtn__ic"><Icon name="arrow-up-right" size={20} /></span>
        </a>
      </div>
      <div class="khero__kid">
        <span class="khero__disc" aria-hidden="true"></span>
        <Img src={img.ninoKinder} alt={d.hero.alt} sizes="(min-width: 960px) 460px, 70vw" priority widths={[360, 640, 816]} />
      </div>
    </div>
    <div class="khero__clouds" aria-hidden="true"></div>
  </section>

  <section class="section" id="como-aprenden">
    <div class="container grid-2">
      <div class="how__media" data-reveal>
        <div class="how__blob" aria-hidden="true"></div>
        <div class="how__dots dots" aria-hidden="true"></div>
        <figure class="how__a"><Img src={img.aulaKinder} alt={d.how.img1Alt} sizes="(min-width: 1024px) 420px, 80vw" widths={[440, 872]} /></figure>
        <figure class="how__b"><Img src={img.ninoDibujando} alt={d.how.img2Alt} sizes="(min-width: 1024px) 260px, 50vw" widths={[300, 600]} /></figure>
        <ul class="how__chips" role="list" aria-hidden="true">
          {d.how.items.map((it, i) => <li class={`how__chip how__chip--${howTones[i]}`}><Icon name={it.icon} size={20} /></li>)}
        </ul>
      </div>
      <div>
        <h2 data-reveal>{d.how.title}</h2>
        <ul class="how__list" role="list">
          {d.how.items.map((it, i) => (
            <li class={`how__item how__item--${howTones[i]}`} data-reveal style={`--d:${i * 70}ms`}>
              <span class="how__ic"><Icon name={it.icon} /></span>
              <div><h3>{it.title}</h3><p class="text-j">{it.text}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section pillars-sec">
    <img class="pillars-sec__kite" src={kite1.src} alt="" width="200" height="215" loading="lazy" />
    <div class="container">
      <h2 class="center" data-reveal>{d.pillars.title}</h2>
      <div class="mt-3"><Pillars items={d.pillars.items} /></div>
    </div>
  </section>

  <section class="grades-sec bg-gradient">
    <Clouds flip />
    <img class="grades-sec__kite" src={kite2.src} alt="" width="200" height="244" loading="lazy" />
    <div class="container section-sm">
      <h2 class="center" data-reveal>{d.grades.title}</h2>
      <div class="mt-2">
        <Grades label={d.grades.title} prev={ui.prev} next={ui.next} items={d.grades.items.map((g, i) => ({ ...g, img: gradeImgs[i], alt: g.quote }))} />
      </div>
    </div>
    <Clouds />
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement} /></div>
  </section>
</Base>

<style>
  .khero { position: relative; background: var(--navy-700); color: #fff; overflow: hidden; isolation: isolate; }
  .khero::before { content: ''; position: absolute; inset: 0 0 auto; height: clamp(22px, 2.6vw, 40px); background: var(--torn) top center / auto 100% repeat-x; z-index: 3; margin-top: -1px; }
  .khero__in { position: relative; z-index: 1; display: grid; gap: 1rem; align-items: end; padding-top: clamp(4rem, 8vw, 6.5rem); }
  .khero__copy { align-self: center; display: grid; gap: 1.6rem; justify-items: start; max-width: 600px; padding-bottom: clamp(5rem, 10vw, 9rem); }
  .khero h1 { color: #fff; font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem); line-height: 1.1; }
  .khero__l { display: block; }
  .khero__l + .khero__l { margin-top: 0.12em; }
  .js .khero__l { animation: rise 800ms var(--ease-out) both; }
  .js .khero__l:nth-child(2) { animation-delay: 100ms; } .js .khero__l:nth-child(3) { animation-delay: 200ms; }
  .khero mark { display: inline-block; background: var(--sky-300); color: var(--navy-900); padding: 0.02em 0.3em 0.08em; border-radius: 10px; }
  .khero__copy p { color: #dbe6ef; font-weight: 500; }
  .kbtn { display: inline-flex; align-items: center; gap: 2px; }
  .kbtn__label { display: inline-flex; align-items: center; min-height: 52px; padding: 0 1.75rem; border-radius: 999px; background: #fff; color: var(--navy-900); font-weight: 600; transition: background-color var(--dur-2); }
  .kbtn__ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; color: var(--navy-900); transition: transform var(--dur-3) var(--ease-out); }
  .kbtn:hover .kbtn__ic { transform: rotate(45deg); }
  .kbtn:hover .kbtn__label { background: var(--sky-100); }
  .kbtn:active { transform: scale(0.98); }
  .khero__kid { position: relative; justify-self: center; width: min(78vw, 440px); margin-bottom: clamp(1rem, 3vw, 2.5rem); }
  .khero__kid :global(img) { position: relative; width: 100%; height: auto; }
  .khero__disc { position: absolute; left: -4%; right: -4%; bottom: -10%; aspect-ratio: 1; border-radius: 50%; background: rgb(255 255 255 / 0.12); }
  .khero__clouds { position: absolute; left: 0; right: 0; bottom: -2px; z-index: 2; height: clamp(90px, 11vw, 200px); background: var(--clouds) bottom center / auto 100% repeat-x; pointer-events: none; }
  @media (min-width: 960px) { .khero__in { grid-template-columns: 1.1fr 0.9fr; } .khero__kid { justify-self: end; margin-right: 4%; } }

  .kfloat { position: absolute; z-index: 1; pointer-events: none; height: auto; }
  .kfloat--balloon { width: clamp(40px, 4.5vw, 72px); left: 2.5%; top: 34%; animation: drift 7s ease-in-out infinite; }
  .kfloat--book { width: clamp(64px, 7vw, 118px); left: 56%; top: 20%; animation: wobble 6s ease-in-out infinite; }
  .kfloat--string { width: clamp(40px, 4vw, 70px); right: 8%; top: 52%; animation: sway 5s ease-in-out infinite; transform-origin: top center; }
  @keyframes drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(6px, -18px); } }
  @keyframes wobble { 0%, 100% { transform: rotate(-6deg) translateY(0); } 50% { transform: rotate(4deg) translateY(-10px); } }
  @keyframes sway { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(6deg); } }
  /* La abejita recorre la portada */
  .kbee { position: absolute; z-index: 2; left: 0; top: 0; width: clamp(40px, 3.6vw, 60px); pointer-events: none; animation: beePath 22s linear infinite; }
  .kbee img { width: 100%; height: auto; animation: beeBob 0.9s ease-in-out infinite alternate; }
  @keyframes beePath {
    0% { transform: translate(-10vw, 55vh) scaleX(1); }
    22% { transform: translate(28vw, 38vh) scaleX(1); }
    40% { transform: translate(46vw, 62vh) scaleX(1); }
    49.9% { transform: translate(82vw, 30vh) scaleX(1); }
    50% { transform: translate(82vw, 30vh) scaleX(-1); }
    70% { transform: translate(60vw, 14vh) scaleX(-1); }
    85% { transform: translate(30vw, 48vh) scaleX(-1); }
    100% { transform: translate(-10vw, 55vh) scaleX(-1); }
  }
  @keyframes beeBob { from { translate: 0 -4px; } to { translate: 0 4px; } }
  @keyframes rise { from { opacity: 0; transform: translateY(20px); } }
  @media (max-width: 959px) { .kfloat--book { left: auto; right: 8%; top: 52%; } .kfloat--string { display: none; } .kfloat--balloon { left: auto; right: 6%; top: 5%; } }
  @media (prefers-reduced-motion: reduce) { .kfloat, .kbee, .kbee img, .js .khero__l { animation: none !important; } .kbee { display: none; } }

  .how__media { position: relative; padding: 1.5rem 0 4rem 3rem; max-width: 540px; width: 100%; justify-self: center; }
  .how__blob { position: absolute; inset: 0 8% 10% 0; border-radius: 40px; background: linear-gradient(150deg, var(--sage-100), var(--sky-100) 55%, var(--clay-100)); transform: rotate(-3deg); }
  .how__dots { position: absolute; right: 0; bottom: 2%; width: 38%; height: 26%; }
  .how__a { position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: 32px; overflow: hidden; box-shadow: var(--shadow-lg); width: 88%; margin-left: auto; }
  .how__b { position: absolute; left: 0; bottom: 0; margin: 0; width: 46%; aspect-ratio: 1; border-radius: 28px; overflow: hidden; border: 8px solid #fff; box-shadow: var(--shadow-lg); }
  .how__a :global(img), .how__b :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .how__chips { position: absolute; right: -2%; top: 14%; display: grid; gap: 0.6rem; padding: 0.6rem; border-radius: 22px; background: rgb(255 255 255 / 0.92); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: var(--shadow-lg); }
  .how__chip { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; color: #fff; }
  .how__chip--sage { background: var(--sage-500); } .how__chip--clay { background: var(--clay-500); } .how__chip--sky { background: #6f97ab; } .how__chip--navy { background: var(--navy-700); }
  .js .how__chips { animation: floatY 7s ease-in-out infinite; }
  @keyframes floatY { 50% { translate: 0 -10px; } }
  .how__list { display: grid; gap: 0.9rem; margin-top: 2rem; }
  .how__item { --tone: var(--sage-500); --tone-bg: var(--sage-100); display: flex; gap: 1rem; align-items: flex-start; padding: 1.1rem 1.25rem; border-radius: 20px; background: #fff; border: 1px solid var(--line); transition: border-color var(--dur-2), box-shadow var(--dur-3), transform var(--dur-3) var(--ease-out); }
  .how__item--clay { --tone: var(--clay-500); --tone-bg: var(--clay-100); } .how__item--sky { --tone: #6f97ab; --tone-bg: #e8f1f5; } .how__item--navy { --tone: var(--navy-700); --tone-bg: var(--sky-100); }
  .how__item:hover { border-color: var(--tone); box-shadow: var(--shadow); transform: translateX(4px); }
  .how__ic { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 14px; background: var(--tone-bg); color: var(--tone); }
  .how__list h3 { font-size: var(--fs-base); }
  .how__list p { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 0.25rem; }
  @media (max-width: 520px) { .how__media { padding-left: 1rem; } .how__chips { right: 0; } }
  @media (prefers-reduced-motion: reduce) { .js .how__chips { animation: none; } }

  .pillars-sec { position: relative; }
  .pillars-sec__kite { position: absolute; right: 2%; top: 3rem; width: clamp(90px, 10vw, 150px); opacity: 0.95; pointer-events: none; }
  .grades-sec { position: relative; }
  .grades-sec__kite { position: absolute; left: 1%; top: 6rem; width: clamp(80px, 8vw, 130px); pointer-events: none; z-index: 1; }
  @media (max-width: 900px) { .pillars-sec__kite, .grades-sec__kite { display: none; } }
</style>

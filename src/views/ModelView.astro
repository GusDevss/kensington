---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Statement from '@/components/ui/Statement.astro';
import ModelWheel from '@/components/sections/ModelWheel.astro';
import Rich from '@/components/ui/Rich.astro';
import { img } from '@/config/images';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/routes';
import data from '@/data/model';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const ui = t(lang);
const tones = ['sage', 'clay', 'sky'];
const essenceImgs = [img.aulaKinderInterior, img.campus12, img.aulaPrimaria, img.primariaJuegos, img.campus19, img.campus4];
---
<Base lang={lang} routeKey="model" title={d.meta.title} description={d.meta.description} image={img.adnAltanima} crumbs={[{ name: ui.nav.model, key: 'model' }]}>
  <section class="mhero bg-gradient">
    <div class="container mhero__in">
      <div class="mhero__dna" data-reveal>
        <Img src={img.adnAltanima} alt={d.hero.dnaAlt} sizes="(min-width: 960px) 360px, 60vw" priority widths={[360, 768]} />
      </div>
      <div class="mhero__copy">
        <span class="eyebrow">{d.hero.eyebrow}</span>
        <Img src={img.altanimaLogo} alt={d.hero.logoAlt} class="mhero__logo" sizes="260px" widths={[260, 520]} />
        <h1>{d.hero.title}</h1>
        {d.hero.paragraphs.map((p) => <p class="text-j"><Rich text={p} /></p>)}
      </div>
    </div>
    <div class="container mhero__extra">
      {d.hero.extra.map((p) => <p class="text-j" data-reveal><Rich text={p} /></p>)}
    </div>
  </section>

  <section class="section-sm"><div class="container"><Statement {...d.statement} /></div></section>

  <section class="section-sm">
    <div class="container">
      <ModelWheel dims={d.wheel.dims} community={d.wheel.community} ring={d.wheel.ring} axes={d.wheel.axes} hint={d.wheel.hint} objectivesLabel={d.wheel.objectives} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="center" data-reveal>{d.includes.title}</h2>
      <div class="incl" data-tabs>
        <div class="incl__list" role="tablist" aria-label={d.includes.title}>
          {d.includes.tabs.map((tab, i) => (
            <button role="tab" id={`inc-tab-${i}`} aria-controls={`inc-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <Icon name={tab.icon} size={18} />{tab.label}
            </button>
          ))}
        </div>
        {d.includes.tabs.map((tab, i) => (
          <ul class="incl__panel" role="tabpanel" id={`inc-panel-${i}`} aria-labelledby={`inc-tab-${i}`} hidden={i !== 0}>
            {tab.items.map((it) => (
              <li><span class="incl__ic"><Icon name={it.i} size={26} /></span><span>{it.t}</span></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="ess__head" data-reveal>
        <h2>{d.essence.title}</h2>
        <p class="lead">{d.essence.text}</p>
      </div>
      <div class="ess" data-carousel data-autoplay="4500" aria-roledescription="carousel" aria-label={d.essence.title}>
        <ul class="ess__track" role="list" data-track>
          {d.essence.items.map((e, i) => {
            const m = e.title.match(/^(\d+)\.\s*(.*)$/);
            return (
              <li class:list={['ess__card', `ess__card--${tones[i % 3]}`]}>
                <div class="ess__img">
                  <Img src={essenceImgs[i]} alt="" sizes="(min-width: 1100px) 380px, 80vw" widths={[400, 760]} />
                  <span class="ess__num" aria-hidden="true">{m ? m[1].padStart(2, '0') : ''}</span>
                </div>
                <div class="ess__body"><h3>{m ? m[2] : e.title}</h3><p>{e.text}</p></div>
              </li>
            );
          })}
        </ul>
        <div class="ess__nav">
          <button class="icon-btn" type="button" data-prev aria-label={ui.prev}><Icon name="arrow-left" /></button>
          <div class="cdots" data-dots></div>
          <button class="icon-btn" type="button" data-next aria-label={ui.next}><Icon name="arrow-right" /></button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .mhero { padding-block: clamp(3rem, 6vw, 5rem); }
  .mhero__in { display: grid; gap: 2.5rem; align-items: center; }
  .mhero__dna { justify-self: center; width: min(70vw, 340px); }
  .mhero__dna :global(img) { width: 100%; height: auto; }
  .mhero__copy { display: grid; gap: 1.1rem; justify-items: start; }
  .mhero__copy :global(.mhero__logo) { width: 220px; height: auto; }
  .mhero__copy h1 { font-size: var(--fs-3xl); color: var(--navy-800); }
  @media (min-width: 960px) { .mhero__in { grid-template-columns: 0.75fr 1.25fr; } }
  .mhero__extra { display: grid; gap: 1rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .mhero__extra { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .mhero__punch { font-weight: 600; color: var(--navy-800); }

  .incl { display: grid; gap: 2rem; margin-top: 2.5rem; }
  .incl__list { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  .incl__list [role='tab'] { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.4rem; border-radius: 999px; border: 1px solid var(--line); font-weight: 600; color: var(--navy-800); transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2), border-color var(--dur-2); }
  .incl__list [role='tab']:hover { border-color: var(--navy-600); }
  .incl__list [role='tab'][aria-selected='true'] { background: var(--navy-700); border-color: var(--navy-700); color: #fff; }
  .incl__panel { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(130px, 1fr); gap: 0.75rem; list-style: none; padding: 0.25rem 0.25rem 0.75rem; overflow-x: auto; scrollbar-width: thin; }
  @media (min-width: 1100px) { .incl__panel { overflow: visible; justify-content: center; grid-auto-columns: minmax(0, 168px); } }
  .incl__panel:not([hidden]) { animation: fade var(--dur-3) var(--ease-out); }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }
  .incl__panel li { display: grid; justify-items: center; align-content: start; gap: 0.7rem; padding: 1.25rem 0.75rem; text-align: center; border-radius: var(--radius-lg); border: 1px solid var(--line); background: #fff; font-size: 0.85rem; font-weight: 600; line-height: 1.35; color: var(--ink); transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3), border-color var(--dur-2); }
  .incl__panel li:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--sky-300); }
  .incl__ic { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--sky-100); color: var(--navy-700); transition: background-color var(--dur-2), color var(--dur-2); }
  .incl__panel li:hover .incl__ic { background: var(--navy-700); color: #fff; }

  .ess__head { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  @media (min-width: 900px) { .ess__head { grid-template-columns: 1fr 1fr; align-items: end; gap: 3rem; } }
  .ess__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(84%, 340px); gap: 1.5rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.75rem 4px 2rem; scrollbar-width: none; }
  .ess__track::-webkit-scrollbar { display: none; }
  @media (min-width: 1100px) { .ess__track { grid-auto-columns: calc((100% - 2 * 1.5rem) / 3); } }
  .ess__card { --tone: var(--sage-400); scroll-snap-align: start; display: flex; flex-direction: column; border-radius: 28px; overflow: hidden; background: #fff; box-shadow: 0 1px 2px rgb(20 33 49 / 0.06), 0 12px 30px -18px rgb(20 33 49 / 0.35); transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3); }
  .ess__card--clay { --tone: var(--clay-400); } .ess__card--sky { --tone: var(--sky-300); }
  .ess__img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .ess__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(200deg, transparent 40%, rgb(20 33 49 / 0.65)); }
  .ess__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .ess__num { position: absolute; left: 1.25rem; bottom: 0.6rem; z-index: 1; font-size: 3.5rem; font-weight: 800; line-height: 1; color: #fff; letter-spacing: -0.04em; text-shadow: 0 4px 18px rgb(0 0 0 / 0.3); }
  .ess__body { display: grid; gap: 0.5rem; padding: 1.4rem 1.5rem 1.75rem; border-top: 4px solid var(--tone); }
  .ess__body h3 { font-size: var(--fs-lg); text-transform: uppercase; letter-spacing: 0.04em; color: var(--navy-800); }
  .ess__body p { font-size: var(--fs-sm); color: var(--ink-2); }
  @media (hover: hover) and (pointer: fine) { .ess__card:hover { transform: translateY(-6px); box-shadow: 0 2px 4px rgb(20 33 49 / 0.06), 0 26px 50px -22px rgb(20 33 49 / 0.45); } .ess__card:hover .ess__img :global(img) { transform: scale(1.07); } }
  .ess__nav { display: flex; align-items: center; justify-content: center; gap: 1.25rem; }
</style>

---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Statement from '@/components/ui/Statement.astro';
import IconPanel from '@/components/sections/IconPanel.astro';
import Rich from '@/components/ui/Rich.astro';
import { img } from '@/config/images';
import { t } from '@/i18n/ui';
import { routes, type Lang } from '@/i18n/routes';
import data from '@/data/about';
import stroke from '@/assets/deco/trazo-azul.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const ui = t(lang);
// Cada frase del título en su propia línea
const titleLines = d.hero.title.split(/(?<=\.)\s+/);
---
<Base lang={lang} routeKey="about" title={d.meta.title} description={d.meta.description} image={img.fachadaLateral} crumbs={[{ name: ui.nav.aboutUs, key: 'about' }]}>
  <section class="section ahero">
    <div class="container">
      <div class="ahero__head">
        <span class="eyebrow" data-reveal>{d.hero.eyebrow}</span>
        <h1 data-reveal>{titleLines.map((l, i) => <span class={`ahero__line ahero__line--${i}`}>{l}</span>)}</h1>
      </div>
      <div class="ahero__grid">
        <div class="ahero__mosaic" data-reveal>
          <div class="ahero__video">
            <video data-bgvideo muted loop playsinline preload="none" poster="/video/patio-carrera-vertical.jpg" aria-hidden="true">
              <source src="/video/patio-carrera-vertical.mp4" type="video/mp4" />
            </video>
            <span class="ahero__tag"><Icon name="sparkles" size={16} />{d.hero.tag}</span>
          </div>
          <div class="ahero__ph ahero__ph--a"><Img src={img.entradaFamilias} alt={d.hero.img1Alt} sizes="(min-width: 960px) 260px, 45vw" widths={[320, 640]} /></div>
          <div class="ahero__ph ahero__ph--b"><Img src={img.aulaMaqueta} alt={d.hero.img2Alt} sizes="(min-width: 960px) 260px, 45vw" widths={[320, 640]} /></div>
        </div>
        <div class="ahero__text">
          {d.hero.paragraphs.map((p, i) => <p class:list={['text-j', { 'ahero__last': i === d.hero.paragraphs.length - 1 }]} data-reveal><Rich text={p} /></p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm"><div class="container"><Statement {...d.statement} /></div></section>

  <section class="section mission">
    <div class="container mission__grid">
      <div class="mission__kid" data-reveal>
        <div class="mission__dots dots" aria-hidden="true"></div>
        <Img src={img.ninoRubio} alt={d.mission.kidAlt} sizes="(min-width: 960px) 380px, 70vw" widths={[360, 640, 816]} />
      </div>
      <div class="mission__content">
        <div class="mission__head" data-reveal>
          <div>
            <span class="eyebrow">{d.mission.eyebrow}</span>
            <h2>{d.mission.title}</h2>
            <p class="muted">{d.mission.text}</p>
          </div>
        </div>
        <div class="mission__body">
          <div class="mission__tabs" data-tabs>
            <div role="tablist" aria-label={d.mission.title} class="tablist">
              {d.mission.tabs.map((tab, i) => (
                <button role="tab" id={`mv-tab-${i}`} aria-controls={`mv-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  <Icon name={tab.icon} size={18} />{tab.label}
                </button>
              ))}
            </div>
            {d.mission.tabs.map((tab, i) => (
              <div role="tabpanel" id={`mv-panel-${i}`} aria-labelledby={`mv-tab-${i}`} hidden={i !== 0} class="tabpanel">
                <p class="text-j">{tab.parts.map(([txt, strong]) => (strong ? <strong>{txt}</strong> : txt))}</p>
              </div>
            ))}
          </div>
          <div class="mission__img" data-reveal>
            <img class="mission__stroke" src={stroke.src} alt="" width="140" height="86" loading="lazy" />
            <div class="media"><Img src={img.campus6} alt={d.mission.imgAlt} sizes="(min-width: 960px) 360px, 90vw" widths={[480, 960]} /></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <IconPanel title={d.values.title} items={d.values.items}>
    <p class="side-quote">{d.values.side}</p>
    <a class="btn btn-light" href={routes.contact[lang]}>{d.values.cta}<Icon name="arrow-up-right" /></a>
  </IconPanel>
</Base>

<style>
  .ahero__head { display: grid; gap: 1.1rem; justify-items: start; margin-bottom: clamp(2rem, 4vw, 3.5rem); padding-bottom: clamp(1.5rem, 3vw, 2.25rem); border-bottom: 1px solid var(--line); }
  .ahero__head h1 { display: grid; font-size: clamp(2.1rem, 1.3rem + 3.2vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
  .ahero__line--1 { color: var(--sage-500); }
  .ahero__line--2 { color: var(--clay-500); }
  @media (min-width: 900px) { .ahero__line--1 { padding-left: 1.5em; } .ahero__line--2 { padding-left: 3em; } }
  .ahero__grid { display: grid; gap: 2.5rem; align-items: center; }
  .ahero__mosaic { display: grid; grid-template-columns: 1.1fr 1fr; grid-template-rows: 1fr 1fr; gap: 0.85rem; min-height: 520px; }
  .ahero__video { position: relative; grid-row: 1 / 3; overflow: hidden; border-radius: var(--radius-xl); background: var(--navy-800); }
  .ahero__video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ahero__tag { position: absolute; left: 1rem; bottom: 1rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.55rem 0.95rem; border-radius: 999px; background: rgb(255 255 255 / 0.92); color: var(--navy-800); font-weight: 700; font-size: var(--fs-xs); box-shadow: var(--shadow); }
  .ahero__ph { position: relative; overflow: hidden; border-radius: var(--radius-lg); }
  .ahero__ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ahero__ph--a :global(img) { object-position: 50% 35%; }
  .ahero__text { display: grid; gap: 1.1rem; }
  .ahero__last { font-weight: 500; color: var(--navy-800); }
  @media (min-width: 960px) { .ahero__grid { grid-template-columns: 1fr 1fr; gap: 3.5rem; } .ahero__mosaic { min-height: 600px; } }
  @media (max-width: 560px) { .ahero__mosaic { min-height: 440px; } }

  .mission { background: linear-gradient(180deg, #fff, var(--paper-2)); }
  .mission__grid { display: grid; gap: 3rem; align-items: center; }
  .mission__kid { position: relative; max-width: 380px; justify-self: center; }
  .mission__kid :global(img) { position: relative; width: 100%; height: auto; }
  .mission__dots { position: absolute; left: -10%; top: 10%; width: 60%; height: 40%; }
  .mission__content { display: grid; gap: 2rem; }
  .mission__head > div { display: grid; gap: 0.9rem; justify-items: start; }
  .mission__body { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 720px) { .mission__body { grid-template-columns: 1fr 0.9fr; } }
  @media (min-width: 1024px) { .mission__grid { grid-template-columns: 0.7fr 1.3fr; } }
  .tablist { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--navy-800); }
  .tablist [role='tab'] { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.1rem; border-radius: 999px; color: #c8d5e2; font-weight: 600; font-size: var(--fs-sm); transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2); }
  .tablist [role='tab'][aria-selected='true'] { background: #fff; color: var(--navy-800); }
  .tabpanel { margin-top: 1.5rem; }
  .tabpanel:not([hidden]) { animation: fade var(--dur-3) var(--ease-out); }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } }
  .mission__img { position: relative; }
  .mission__img .media { aspect-ratio: 4 / 3; }
  .mission__stroke { position: absolute; right: -10px; top: -46px; width: 110px; z-index: 1; }

  .side-quote { color: #fff; font-size: var(--fs-2xl); font-weight: 700; line-height: 1.3; text-wrap: balance; }
</style>

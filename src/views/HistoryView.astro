---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Statement from '@/components/ui/Statement.astro';
import { img } from '@/config/images';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/routes';
import data from '@/data/history';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const ui = t(lang);
const tones = ['navy', 'sage', 'clay', 'sky'];
const tabImgs = [img.fachadaPrincipal, img.patioCentral, img.patioVentanales, img.jardinJuegos];
---
<Base lang={lang} routeKey="history" title={d.meta.title} description={d.meta.description} image={img.patioCentral} crumbs={[{ name: ui.nav.history, key: 'history' }]}>
  <section class="section-sm hintro">
    <div class="container hintro__in">
      <h1 data-reveal>{d.intro.title}</h1>
      <p class="text-j lead" data-reveal>{d.intro.text}</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2 class="hq" data-reveal>{d.question}</h2>
      <div class="htabs" data-tabs>
        <div class="htabs__list" role="tablist" aria-label={d.question} aria-orientation="vertical">
          {d.tabs.map((tab, i) => (
            <button role="tab" id={`h-tab-${i}`} aria-controls={`h-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <Icon name={tab.icon} size={20} /><span>{tab.label}</span>
            </button>
          ))}
        </div>
        {d.tabs.map((tab, i) => (
          <div class="htabs__panel" role="tabpanel" id={`h-panel-${i}`} aria-labelledby={`h-tab-${i}`} hidden={i !== 0}>
            <div class="htabs__text">
              <h3>{tab.title}</h3>
              <p class="text-j">{tab.text}</p>
            </div>
            <div class="htabs__img"><Img src={tabImgs[i]} alt="" sizes="(min-width: 1024px) 380px, 90vw" widths={[480, 960]} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm"><div class="container"><Statement {...d.statement1} /></div></section>

  <section class="marquee" aria-label="Kensington Academy">
    <div class="marquee__track">
      {[0, 1].map((n) => (
        <ul role="list" aria-hidden={n === 1 ? 'true' : undefined}>
          {d.marquee.map((m, i) => (
            <li class:list={{ outline: i % 2 === 1 }}><img src="/brand/escudo-white.svg" alt="" width="36" height="36" />{m}</li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{d.philosophy.title}</h2>
      </div>
      <Statement {...d.philosophy.subtitle} class="phil__sub" />
      <div class="phil" data-carousel data-autoplay="6000">
        <div class="phil__panel">
          <ul class="phil__track" role="list" data-track>
            {d.philosophy.items.map((it) => {
              const m = it.title.match(/^(\d+)\.\s*(.*)$/);
              const num = m ? m[1].padStart(2, '0') : '';
              return (
                <li class="phil__slide">
                  <span class="phil__num" aria-hidden="true">{num}</span>
                  <div class="phil__txt">
                    <h3>{m ? m[2] : it.title}</h3>
                    <p class="text-j">{it.text}</p>
                  </div>
                </li>
              );
            })}
          </ul>
          <div class="phil__nav">
            <button class="icon-btn phil__btn" type="button" data-prev aria-label={ui.prev}><Icon name="arrow-left" /></button>
            <div class="cdots cdots--light" data-dots></div>
            <button class="icon-btn phil__btn" type="button" data-next aria-label={ui.next}><Icon name="arrow-right" /></button>
          </div>
        </div>
        <div class="phil__img" aria-hidden="true">
          <span class="phil__ring"></span>
          <Img src={img.ninaPrimaria} alt="" sizes="(min-width: 960px) 300px, 60vw" widths={[360, 622]} />
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm"><div class="container"><Statement {...d.statement2} mark="circle" /></div></section>

  <section class="section">
    <div class="container">
      <h2 class="center" data-reveal>{d.principles.title}</h2>
      <div class="prin" data-carousel data-autoplay="4000">
        <ul class="prin__track" role="list" data-track>
          {d.principles.items.map((p, i) => (
            <li class:list={['prin__card', `prin__card--${tones[i % 4]}`]}>
              <span class="icon-badge"><Icon name={p.icon} /></span>
              <h3>{p.title}</h3>
              <p class="text-j">{p.text}</p>
              <span class="prin__tag">{d.principles.label} #{i + 1}</span>
              <span class="prin__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))}
        </ul>
        <div class="prin__nav">
          <button class="icon-btn" type="button" data-prev aria-label={ui.prev}><Icon name="arrow-left" /></button>
          <div class="cdots" data-dots></div>
          <button class="icon-btn" type="button" data-next aria-label={ui.next}><Icon name="arrow-right" /></button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hintro__in { display: grid; gap: 1.5rem; align-items: center; padding-top: 2rem; }
  @media (min-width: 900px) { .hintro__in { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }
  .hq { text-align: center; max-width: 1100px; margin: 0 auto 3rem; font-size: var(--fs-3xl); }

  .htabs { display: grid; gap: 1.5rem; }
  .htabs__list { display: grid; gap: 0.6rem; align-content: start; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .htabs__list [role='tab'] { display: flex; align-items: center; gap: 0.75rem; text-align: left; padding: 1rem 1.1rem; border-radius: var(--radius); font-weight: 600; font-size: var(--fs-sm); color: var(--ink); line-height: 1.35; transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2); }
  .htabs__list [role='tab']:hover { background: var(--paper-2); }
  .htabs__list [role='tab'][aria-selected='true'] { background: var(--navy-700); color: #fff; }
  .htabs__list :global(svg) { flex: none; }
  .htabs__panel { display: grid; overflow: hidden; border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--navy-700), #6f8ea6); color: #e6eef5; }
  .htabs__panel:not([hidden]) { animation: fade var(--dur-3) var(--ease-out); }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }
  .htabs__text { display: grid; gap: 1rem; align-content: center; padding: clamp(1.5rem, 3vw, 2.5rem); }
  .htabs__text h3 { color: #fff; font-size: var(--fs-lg); line-height: 1.35; }
  .htabs__img { position: relative; min-height: 240px; }
  .htabs__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 720px) { .htabs__panel { grid-template-columns: 1.15fr 0.85fr; } }
  @media (min-width: 1024px) { .htabs { grid-template-columns: 330px 1fr; } }

  .marquee { background: var(--navy-800); padding-block: 2.25rem; overflow: hidden; }
  .marquee__track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee ul { display: flex; flex: none; }
  .marquee li { display: flex; align-items: center; gap: 1.5rem; padding-right: 3rem; color: #fff; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); font-weight: 600; white-space: nowrap; }
  .marquee li img { width: 36px; opacity: 0.8; }
  .marquee li.outline { color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.75); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }

:global(.phil__sub) { margin-top: -2rem; margin-bottom: 4.5rem; }
  .phil { position: relative; display: grid; align-items: end; border-radius: var(--radius-xl); background: linear-gradient(120deg, var(--navy-800), var(--navy-600) 55%, #7f9db3); isolation: isolate; }
  .phil::before { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: -1; background-image: radial-gradient(rgb(255 255 255 / 0.12) 1.2px, transparent 1.4px); background-size: 18px 18px; mask-image: linear-gradient(90deg, transparent, #000 70%); }
  .phil__panel { min-width: 0; display: grid; gap: 1.75rem; padding: clamp(1.75rem, 4vw, 3rem); }
  .phil__track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .phil__track::-webkit-scrollbar { display: none; }
  .phil__slide { scroll-snap-align: start; display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.75rem; align-items: start; color: #e6eef5; }
  .phil__num { font-size: clamp(3.5rem, 2.5rem + 4vw, 6rem); font-weight: 800; line-height: 0.85; color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.55); letter-spacing: -0.04em; }
  .phil__txt { display: grid; gap: 0.9rem; }
  .phil__slide h3 { color: #fff; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.25; }
  .phil__slide p { font-size: var(--fs-lg); color: #dbe6ef; }
  .phil__nav { display: flex; align-items: center; gap: 1.25rem; }
  .phil :global(.phil__btn) { background: rgb(255 255 255 / 0.1); border-color: rgb(255 255 255 / 0.25); color: #fff; }
  .phil :global(.phil__btn:hover) { background: #fff; color: var(--navy-800); }
  .phil__img { position: relative; justify-self: center; width: min(70vw, 290px); margin-top: -70px; }
  .phil__img :global(img) { position: relative; width: 100%; height: auto; filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.3)); }
  .phil__ring { position: absolute; left: 50%; bottom: 0; width: 120%; aspect-ratio: 1; translate: -50% 18%; border-radius: 50%; background: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 14px rgb(255 255 255 / 0.05); }
  .phil__img { clip-path: inset(-400px -60px 0 -60px); }
  @media (min-width: 900px) { .phil { grid-template-columns: 1fr 320px; } .phil__img { margin-top: -90px; padding-top: 90px; margin-right: 1rem; overflow: visible; } }
  @media (max-width: 640px) { .phil__slide { grid-template-columns: 1fr; } }

  .prin { margin-top: 2.5rem; }
  .prin__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(82%, 300px); gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.75rem 4px 1.75rem; scrollbar-width: none; }
  .prin__track::-webkit-scrollbar { display: none; }
  @media (min-width: 1100px) { .prin__track { grid-auto-columns: calc((100% - 3 * 1.25rem) / 4); } }
  .prin__card { --tone: var(--navy-600); --tone-bg: var(--sky-100); position: relative; overflow: hidden; scroll-snap-align: start; display: flex; flex-direction: column; gap: 0.9rem; padding: 1.75rem; border-radius: 24px; background: #fff; box-shadow: 0 1px 2px rgb(20 33 49 / 0.06), 0 12px 30px -18px rgb(20 33 49 / 0.35); border-top: 5px solid var(--tone); transition: box-shadow var(--dur-3), transform var(--dur-3) var(--ease-out); }
  .prin__card--sage { --tone: var(--sage-500); --tone-bg: var(--sage-100); }
  .prin__card--clay { --tone: var(--clay-500); --tone-bg: var(--clay-100); }
  .prin__card--sky { --tone: #6f97ab; --tone-bg: var(--sky-100); }
  .prin__card :global(.icon-badge) { background: var(--tone-bg); color: var(--tone); transition: transform var(--dur-3) var(--ease-out); }
  .prin__num { position: absolute; right: 1rem; top: 0.25rem; font-size: 4.5rem; font-weight: 800; line-height: 1; color: var(--tone-bg); letter-spacing: -0.04em; z-index: 0; pointer-events: none; }
  .prin__card > :not(.prin__num) { position: relative; z-index: 1; }
  @media (hover: hover) and (pointer: fine) {
    .prin__card:hover { transform: translateY(-6px); box-shadow: 0 2px 4px rgb(20 33 49 / 0.06), 0 26px 50px -22px rgb(20 33 49 / 0.45); }
    .prin__card:hover :global(.icon-badge) { transform: rotate(-8deg) scale(1.08); }
  }
  .prin__card h3 { font-size: var(--fs-lg); }
  .prin__card p { font-size: var(--fs-sm); color: var(--ink-3); flex: 1; }
  .prin__tag { align-self: start; padding: 0.35rem 0.8rem; border-radius: 8px; background: var(--tone-bg); font-size: var(--fs-xs); font-weight: 700; color: var(--tone); }
  .prin__nav { display: flex; align-items: center; justify-content: center; gap: 1.25rem; }
</style>

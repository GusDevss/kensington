---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Statement from '@/components/ui/Statement.astro';
import Accordion from '@/components/ui/Accordion.astro';
import { img } from '@/config/images';
import { site } from '@/config/site';
import { routes, type Lang } from '@/i18n/routes';
import data from '@/data/home';
import { t } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const half = Math.ceil(d.why.items.length / 2);
const slides = [img.fachadaPrincipal, img.patioCentral, img.patioVentanales, img.fachadaLateral];
const tones = ['clay', 'sage', 'sky'];
const chipIcons = ['languages', 'sparkles', 'brain'];
const quickLinks = [routes.kinder[lang], routes.primary[lang], routes.afterSchool[lang]];
// Arcos de los tres colores de las dimensiones Altanima alrededor de la alumna
const polar = (r: number, deg: number) => { const a = ((deg - 90) * Math.PI) / 180; return `${(200 + r * Math.cos(a)).toFixed(1)} ${(200 + r * Math.sin(a)).toFixed(1)}`; };
const arc = (a0: number, a1: number, r = 165) => `M${polar(r, a0)}A${r} ${r} 0 0 1 ${polar(r, a1)}`;
const arcs = [arc(10, 110), arc(130, 230), arc(250, 350)];
---
<Base lang={lang} routeKey="home" title={d.meta.title} description={d.meta.description} image={img.fachadaPrincipal}>
  <!-- Portada -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__slides" aria-hidden="true">
      {slides.map((src, i) => (
        <div class="hero__slide" style={`--i:${i}`}>
          <Img src={src} alt="" sizes="100vw" priority={i === 0} widths={[768, 1280, 1920]} />
        </div>
      ))}
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__grain" aria-hidden="true"></div>

    <div class="container hero__in">
      <div class="hero__copy">
        <p class="hero__eyebrow"><span class="hero__pulse" aria-hidden="true"></span>{d.hero.eyebrow}</p>
        <h1 id="hero-title">
          {d.hero.title.map((line, i) => {
            const k = d.hero.keys[i];
            const at = line.lastIndexOf(k);
            return (
              <span class="hero__line" style={`--l:${i}`}>
                {line.slice(0, at)}<em class:list={['hero__key', `hero__key--${tones[i]}`]}>{k}</em>{line.slice(at + k.length)}
              </span>
            );
          })}
        </h1>
        <p class="hero__text">{d.hero.text}</p>
        <div class="hero__ctas">
          <a class="btn btn-light" href={routes.contact[lang]}><Icon name="calendar-check" />{d.hero.ctaVisit}</a>
          <a class="btn hero__ghost" href={routes.about[lang]}>{d.hero.cta}<Icon name="arrow-up-right" /></a>
          <button class="hero__play" type="button" data-yt={site.videos.home} aria-label={d.world.play}>
            <span class="hero__play-ic"><Icon name="play" size={18} /></span>
            <span>{d.world.did}</span>
          </button>
        </div>
      </div>

      <div class="hero__visual">
        <svg class="hero__rings" viewBox="0 0 400 400" aria-hidden="true">
          <circle cx="200" cy="200" r="190" fill="none" stroke="rgb(255 255 255 / 0.14)" stroke-dasharray="2 8" />
          <g class="hero__arcs" fill="none" stroke-width="14" stroke-linecap="round">
            <path d={arcs[0]} stroke="var(--sage-400)" />
            <path d={arcs[1]} stroke="var(--clay-400)" />
            <path d={arcs[2]} stroke="var(--sky-300)" />
          </g>
          <circle cx="200" cy="200" r="138" fill="rgb(255 255 255 / 0.08)" />
        </svg>
        <div class="hero__kid">
          <Img src={img.ninaPrimaria} alt={d.hero.imgAlt} sizes="(min-width: 960px) 440px, 64vw" priority widths={[360, 622]} />
        </div>
        <ul class="hero__chips" role="list">
          {d.hero.chips.map((c, i) => (
            <li class:list={['hero__chip', `hero__chip--${i}`]}>
              <span class:list={['hero__chip-ic', `hero__chip-ic--${tones[i]}`]}><Icon name={chipIcons[i]} size={18} /></span>{c}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="container hero__quick" aria-label={d.levels.title}>
      {d.hero.quick.map((q, i) => (
        <a class="hero__q" href={quickLinks[i]}>
          <span class:list={['hero__q-ic', `hero__q-ic--${tones[i]}`]}><Icon name={q.icon} size={22} /></span>
          <span class="hero__q-txt"><strong>{q.title}</strong><span>{q.text}</span></span>
          <span class="hero__q-go"><Icon name="arrow-up-right" size={18} /></span>
        </a>
      ))}
    </nav>
  </section>

  <!-- Bienvenida -->
  <section class="section welcome">
    <div class="container welcome__grid">
      <div class="welcome__media" data-reveal>
        <div class="welcome__blob" aria-hidden="true"></div>
        <div class="welcome__dots dots" aria-hidden="true"></div>
        <figure class="welcome__main"><Img src={img.aulaKinder} alt={d.welcome.img2Alt} sizes="(min-width: 1024px) 440px, 80vw" widths={[440, 872]} /></figure>
        <figure class="welcome__sub"><Img src={img.jardinJuegos} alt={d.welcome.img1Alt} sizes="(min-width: 1024px) 240px, 45vw" widths={[300, 600]} /></figure>
        <div class="welcome__badge">
          <img src="/brand/escudo.svg" alt="" width="44" height="44" />
          <div>
            <strong>{d.welcome.dimsTitle}</strong>
            <ul role="list">
              {d.welcome.dims.map((dm) => <li class={`dim dim--${dm.tone}`}><Icon name={dm.icon} size={14} />{dm.label}</li>)}
            </ul>
          </div>
        </div>
      </div>
      <div class="welcome__copy">
        <span class="eyebrow" data-reveal>{d.welcome.eyebrow}</span>
        <h2 data-reveal>{d.welcome.title}</h2>
        <p class="welcome__lead text-j" data-reveal>{d.welcome.intro}</p>
        {d.welcome.body.map((p) => <p class="text-j" data-reveal>{p}</p>)}
        <div class="welcome__ctas" data-reveal>
          <a class="btn" href={routes.about[lang]}>{d.welcome.cta}<Icon name="arrow-up-right" /></a>
          <a class="welcome__link" href={routes.model[lang]}>{t(lang).nav.model}<Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement1} /></div>
  </section>

  <!-- Cifras -->
  <section class="stats-wrap" aria-label={lang === 'es' ? 'Kensington en cifras' : 'Kensington in numbers'}>
    <div class="container">
      <ul class="stats" role="list">
        {d.stats.map((s, i) => (
          <li data-reveal style={`--d:${i * 80}ms`}>
            <span class="stats__ic"><Icon name={s.icon} size={28} /></span>
            <span class="stats__label">{s.label}</span>
            <strong class="stats__num"><span data-count-to={s.value}>{s.value}</span>{s.suffix}</strong>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- El mundo cambió -->
  <section class="world">
    <div class="world__band">
      <div class="container world__in">
        <h2 data-reveal>{d.world.title[0]} <span class="world__hl">{d.world.title[1]}<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14C60 4 140 4 197 10" /></svg></span><br />{d.world.title[2]}</h2>
        <a class="world__channel" href={site.social.youtube} target="_blank" rel="noopener noreferrer" data-reveal>
          <Img src={img.canalYoutube} alt={d.world.channelAlt} sizes="96px" widths={[192, 336]} />
          <span>{d.world.channel}</span>
          <span class="world__arrow"><Icon name="arrow-up-right" size={20} /></span>
        </a>
      </div>
    </div>
    <div class="world__video">
      <Img src={img.patioCentral} alt="" sizes="100vw" widths={[768, 1280, 2000]} />
      <div class="world__video-in">
        <p class="world__did" aria-hidden="true">{d.world.did}</p>
        <button class="world__play" type="button" data-yt={site.videos.home} aria-label={d.world.play}><Icon name="play" size={30} /></button>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement2} mark="circle" /></div>
  </section>

  <!-- Por qué elegirnos -->
  <section class="section why">
    <div class="container">
      <h2 class="center" data-reveal>{d.why.title}</h2>
      <div class="why__grid">
        <Accordion idPrefix="why-a" items={d.why.items.slice(0, half).map((it, i) => ({ ...it, open: i === 0 }))} />
        <Accordion idPrefix="why-b" items={d.why.items.slice(half).map((it, i) => ({ ...it, open: i === 0 }))} />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement3} /></div>
  </section>

  <!-- Certificaciones -->
  <section class="section certs">
    <div class="container grid-2">
      <div>
        <div class="certs__head" data-reveal>
          <span class="eyebrow">{d.certs.eyebrow}</span>
          <h2>{d.certs.title}</h2>
          <p class="lead">{d.certs.text}</p>
        </div>
        <ul class="certs__list" role="list">
          {d.certs.items.map((c, i) => (
            <li data-reveal style={`--d:${i * 60}ms`}>
              <span class="icon-badge"><Icon name={c.icon} /></span>
              <div><h3>{c.title}</h3><p>{c.text}</p></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="certs__media" data-reveal>
        <div class="certs__blob" aria-hidden="true"></div>
        <Img src={img.maestra} alt={d.certs.imgAlt} sizes="(min-width: 960px) 520px, 90vw" widths={[400, 800]} />
      </div>
    </div>
  </section>

  <!-- Niveles -->
  <section class="section levels">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{d.levels.title}</h2>
        <p>{d.levels.text}</p>
      </div>
      <div class="levels__grid">
        {[
          { ...d.levels.kinder, href: routes.kinder[lang], src: img.ninoKinder, tone: 'sage' },
          { ...d.levels.primary, href: routes.primary[lang], src: img.ninaPrimaria, tone: 'clay' },
        ].map((c, i) => (
          <a class:list={['level', `level--${c.tone}`]} href={c.href} data-reveal style={`--d:${i * 100}ms`}>
            <div class="level__copy">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <span class="btn btn-light btn-sm">{c.cta}<Icon name="arrow-up-right" /></span>
            </div>
            <Img src={c.src} alt={c.alt} class="level__img" sizes="(min-width: 960px) 260px, 45vw" widths={[300, 520]} />
            <svg class="level__spark" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c.6 6.5 5.5 11.4 12 12-6.5.6-11.4 5.5-12 12-.6-6.5-5.5-11.4-12-12C6.5 11.4 11.4 6.5 12 0z" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Portada */
  .hero { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: var(--navy-900); display: grid; grid-template-rows: 1fr auto; min-height: clamp(660px, calc(100svh - 120px), 900px); }
  .hero__slides, .hero__slide { position: absolute; inset: 0; z-index: -3; }
  .hero__slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__slide:not(:first-child) { opacity: 0; }
  .js .hero__slide:not(:first-child) { animation: heroFade 28s var(--ease-in-out) infinite; animation-delay: calc(var(--i) * 7s - 2s); }
  .js .hero__slide :global(img) { animation: kenburns 28s ease-out infinite alternate; transform-origin: 60% 40%; }
  @keyframes heroFade { 0% { opacity: 0; } 5% { opacity: 1; } 25% { opacity: 1; } 30% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes kenburns { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero__shade { position: absolute; inset: 0; z-index: -2; background:
      radial-gradient(120% 80% at 80% 40%, rgb(30 48 69 / 0.15), transparent 60%),
      linear-gradient(95deg, rgb(20 33 49 / 0.94) 0%, rgb(27 43 63 / 0.82) 38%, rgb(30 48 69 / 0.35) 70%, rgb(30 48 69 / 0.2) 100%),
      linear-gradient(0deg, rgb(20 33 49 / 0.9) 0%, transparent 35%); }
  .hero__grain { position: absolute; inset: 0; z-index: -1; opacity: 0.07; background-image: radial-gradient(rgb(255 255 255 / 0.9) 0.6px, transparent 0.7px); background-size: 4px 4px; pointer-events: none; }

  .hero__in { display: grid; align-items: center; gap: 2rem; padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .hero__copy { max-width: 760px; padding-bottom: 2rem; }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.95rem 0.45rem 0.75rem; border-radius: 999px; background: rgb(255 255 255 / 0.1); border: 1px solid rgb(255 255 255 / 0.18); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); font-size: var(--fs-xs); font-weight: 500; letter-spacing: 0.02em; color: #e6eef5; }
  .hero__pulse { position: relative; width: 8px; height: 8px; border-radius: 50%; background: #7fe0c8; }
  .hero__pulse::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid #7fe0c8; opacity: 0; animation: pulse 2.4s var(--ease-out) infinite; }
  @keyframes pulse { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.8); opacity: 0; } }
  .hero h1 { margin-top: 1.5rem; color: #fff; font-size: clamp(2.3rem, 1.4rem + 3.1vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; font-weight: 600; }
  .hero__line { display: block; }
  .js .hero__line { animation: rise 900ms var(--ease-out) both; animation-delay: calc(var(--l) * 110ms + 100ms); }
  .hero__key { font-style: normal; position: relative; white-space: nowrap; background-repeat: no-repeat; background-position: 0 88%; background-size: 100% 0.22em; }
  .js .hero__key { background-size: 0% 0.22em; animation: mark 900ms var(--ease-out) forwards; animation-delay: calc(var(--l) * 110ms + 700ms); }
  .hero__key--clay { background-image: linear-gradient(90deg, var(--clay-400), #e7b49b); }
  .hero__key--sage { background-image: linear-gradient(90deg, var(--sage-400), #cbd9c2); }
  .hero__key--sky { background-image: linear-gradient(90deg, var(--sky-300), #d4e5ee); }
  @keyframes mark { to { background-size: 100% 0.22em; } }
  .hero__text { margin-top: 1.5rem; font-size: var(--fs-lg); color: #d6e1eb; max-width: 48ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.25rem; margin-top: 2.25rem; }
  .hero__ghost { --btn-bg: rgb(255 255 255 / 0.08); --btn-fg: #fff; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.4); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  @media (hover: hover) and (pointer: fine) { .hero__ghost:hover { --btn-bg: #fff; --btn-fg: var(--navy-800); } }
  .hero__play { display: inline-flex; align-items: center; gap: 0.75rem; color: #fff; font-weight: 600; font-size: var(--fs-sm); }
  .hero__play-ic { position: relative; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: rgb(255 255 255 / 0.14); transition: background-color var(--dur-2), color var(--dur-2), transform var(--dur-1) var(--ease-out); }
  .hero__play-ic::before { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.35); animation: pulse 2.8s var(--ease-out) infinite; }
  .hero__play:hover .hero__play-ic { background: #fff; color: var(--navy-800); }
  .hero__play:active .hero__play-ic { transform: scale(0.94); }

  .hero__visual { position: relative; justify-self: center; width: min(86vw, 480px); aspect-ratio: 1 / 1.12; display: grid; place-items: end center; }
  .hero__rings { position: absolute; left: 50%; top: 4%; width: 100%; translate: -50% 0; }
  .js .hero__arcs { transform-origin: 200px 200px; animation: spin 60s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero__kid { position: relative; width: 82%; }
  .hero__kid :global(img) { width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35)); }
  .js .hero__kid { animation: rise 1100ms var(--ease-out) 250ms both; }
  .hero__chips { position: absolute; inset: 0; pointer-events: none; }
  .hero__chip { position: absolute; display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.55rem 0.95rem 0.55rem 0.55rem; border-radius: 999px; background: rgb(255 255 255 / 0.92); color: var(--navy-900); font-size: var(--fs-xs); font-weight: 600; white-space: nowrap; box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.45); }
  .js .hero__chip { animation: chipIn 700ms var(--ease-out) both, float 6s ease-in-out infinite; }
  .hero__chip--0 { left: -8%; top: 22%; animation-delay: 900ms, 1.6s; }
  .hero__chip--1 { right: -6%; top: 40%; animation-delay: 1050ms, 2.4s; }
  .hero__chip--2 { left: -2%; top: 62%; animation-delay: 1200ms, 3.2s; }
  .hero__chip-ic { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; color: #fff; }
  .hero__chip-ic--clay { background: var(--clay-500); } .hero__chip-ic--sage { background: var(--sage-500); } .hero__chip-ic--sky { background: #6f97ab; }
  @keyframes chipIn { from { opacity: 0; transform: translateY(12px) scale(0.92); } }
  @keyframes float { 50% { translate: 0 -8px; } }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

  .hero__quick { position: relative; z-index: 2; display: grid; gap: 0.75rem; padding-bottom: 1.5rem; }
  .hero__q { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1rem 1.1rem; border-radius: var(--radius-lg); background: rgb(20 33 49 / 0.55); border: 1px solid rgb(255 255 255 / 0.16); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); transition: background-color var(--dur-2) var(--ease-out), border-color var(--dur-2), transform var(--dur-3) var(--ease-out); }
  .hero__q-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; color: #fff; }
  .hero__q-ic--clay { background: var(--clay-500); } .hero__q-ic--sage { background: var(--sage-500); } .hero__q-ic--sky { background: #6f97ab; }
  .hero__q-txt { display: grid; gap: 0.1rem; line-height: 1.3; }
  .hero__q-txt strong { color: #fff; font-size: var(--fs-base); }
  .hero__q-txt span { color: #c9d6e2; font-size: var(--fs-xs); }
  .hero__q-go { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.3); transition: transform var(--dur-2) var(--ease-out), background-color var(--dur-2), color var(--dur-2); }
  @media (hover: hover) and (pointer: fine) {
    .hero__q:hover { background: rgb(255 255 255 / 0.16); border-color: rgb(255 255 255 / 0.32); transform: translateY(-3px); }
    .hero__q:hover .hero__q-go { background: #fff; color: var(--navy-800); transform: rotate(45deg); }
  }
  @media (min-width: 760px) { .hero__quick { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) {
    .hero__in { grid-template-columns: 1.3fr 0.7fr; padding-top: 3rem; }
    .hero__visual { justify-self: end; align-self: end; width: min(36vw, 470px); margin-bottom: -6rem; }
    .hero__quick { padding-bottom: 2.5rem; }
  }
  @media (max-width: 1023px) {
    .hero__visual { width: min(78vw, 360px); margin-bottom: -5rem; }
  }
  @media (max-width: 520px) { .hero__chip--1 { display: none; } .hero__chip--0 { left: -2%; } }
  @media (prefers-reduced-motion: reduce) {
    .js .hero__slide, .js .hero__slide :global(img), .js .hero__line, .js .hero__kid, .js .hero__chip, .js .hero__arcs, .hero__pulse::after, .hero__play-ic::before { animation: none !important; }
    .js .hero__key { background-size: 100% 0.22em; animation: none; }
    .hero__slide:not(:first-child) { display: none; }
  }

  /* Bienvenida */
  .welcome__grid { display: grid; gap: clamp(3rem, 2rem + 4vw, 5.5rem); align-items: center; }
  @media (min-width: 1024px) { .welcome__grid { grid-template-columns: 0.95fr 1.05fr; } }
  .welcome__media { position: relative; padding: 2rem 2.5rem 3.5rem 0; max-width: 560px; justify-self: center; width: 100%; }
  .welcome__blob { position: absolute; inset: 8% 0 0 12%; border-radius: 40px; background: linear-gradient(150deg, var(--sky-100), var(--clay-100) 60%, var(--sage-100)); transform: rotate(-3deg); }
  .welcome__dots { position: absolute; right: 0; top: 0; width: 42%; height: 30%; opacity: 0.8; }
  .welcome__main { position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: 32px; overflow: hidden; box-shadow: var(--shadow-lg); width: 86%; }
  .welcome__main :global(img), .welcome__sub :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .welcome__sub { position: absolute; right: 0; bottom: 0; margin: 0; width: 46%; aspect-ratio: 1; border-radius: 28px; overflow: hidden; border: 8px solid #fff; box-shadow: var(--shadow-lg); }
  .welcome__badge { position: absolute; left: -4%; bottom: 18%; display: flex; gap: 0.8rem; align-items: center; padding: 0.9rem 1.1rem; border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: var(--shadow-lg); max-width: 280px; }
  .js .welcome__badge { animation: float 7s ease-in-out infinite; }
  .welcome__badge img { width: 40px; flex: none; }
  .welcome__badge strong { display: block; font-size: var(--fs-sm); color: var(--ink); margin-bottom: 0.4rem; }
  .welcome__badge ul { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .dim { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; }

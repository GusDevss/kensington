---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Statement from '@/components/ui/Statement.astro';
import Accordion from '@/components/ui/Accordion.astro';
import { img } from '@/config/images';
import { site } from '@/config/site';
import { routes, type Lang } from '@/i18n/routes';
import data from '@/data/home';
import capDiploma from '@/assets/deco/birrete-diploma.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const half = Math.ceil(d.why.items.length / 2);
---
<Base lang={lang} routeKey="home" title={d.meta.title} description={d.meta.description} image={img.fachadaPrincipal}>
  <!-- Hero -->
  <section class="hero">
    <Img src={img.fachadaPrincipal} alt="" class="hero__bg" sizes="100vw" priority widths={[768, 1280, 1920]} />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__in">
      <div class="hero__copy">
        <h1>{d.hero.title.map((l) => <span>{l}</span>)}</h1>
        <p>{d.hero.text}</p>
        <div class="hero__ctas">
          <a class="btn btn-light" href={routes.about[lang]}>{d.hero.cta}<Icon name="arrow-up-right" /></a>
          <button class="hero__play" type="button" data-yt={site.videos.home} aria-label={d.world.play}>
            <span class="hero__play-ic"><Icon name="play" size={18} /></span>
            <span>{d.world.did}</span>
          </button>
        </div>
      </div>
      <div class="hero__kid">
        <Img src={img.ninaPrimaria} alt={d.hero.imgAlt} sizes="(min-width: 960px) 460px, 70vw" priority widths={[360, 622]} />
      </div>
    </div>
  </section>

  <!-- Bienvenida -->
  <section class="section">
    <div class="container grid-2 welcome">
      <div class="welcome__media" data-reveal>
        <div class="welcome__dots dots" aria-hidden="true"></div>
        <div class="welcome__a media"><Img src={img.jardinJuegos} alt={d.welcome.img1Alt} sizes="(min-width: 960px) 300px, 50vw" widths={[360, 640, 848]} /></div>
        <div class="welcome__b media"><Img src={img.aulaKinder} alt={d.welcome.img2Alt} sizes="(min-width: 960px) 280px, 45vw" widths={[360, 640, 872]} /></div>
        <img class="welcome__cap" src={capDiploma.src} alt="" width="150" height="86" loading="lazy" />
      </div>
      <div class="welcome__copy">
        <h2 data-reveal>{d.welcome.title}</h2>
        <div class="welcome__intro" data-reveal>
          <img src="/brand/escudo.svg" alt="" width="40" height="40" />
          <p class="text-j">{d.welcome.intro}</p>
        </div>
        {d.welcome.body.map((p) => <p class="text-j" data-reveal>{p}</p>)}
        <a class="btn" href={routes.about[lang]} data-reveal>{d.welcome.cta}<Icon name="arrow-up-right" /></a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement1} /></div>
  </section>

  <!-- Cifras -->
  <section class="stats-wrap" aria-label={lang === 'es' ? 'Kensington en cifras' : 'Kensington in numbers'}>
    <div class="container">
      <ul class="stats" role="list">
        {d.stats.map((s, i) => (
          <li data-reveal style={`--d:${i * 80}ms`}>
            <span class="stats__ic"><Icon name={s.icon} size={28} /></span>
            <span class="stats__label">{s.label}</span>
            <strong class="stats__num"><span data-count-to={s.value}>{s.value}</span>{s.suffix}</strong>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- El mundo cambió -->
  <section class="world">
    <div class="world__band">
      <div class="container world__in">
        <h2 data-reveal>{d.world.title[0]} <span class="world__hl">{d.world.title[1]}<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14C60 4 140 4 197 10" /></svg></span><br />{d.world.title[2]}</h2>
        <a class="world__channel" href={site.social.youtube} target="_blank" rel="noopener noreferrer" data-reveal>
          <Img src={img.canalYoutube} alt={d.world.channelAlt} sizes="96px" widths={[192, 336]} />
          <span>{d.world.channel}</span>
          <span class="world__arrow"><Icon name="arrow-up-right" size={20} /></span>
        </a>
      </div>
    </div>
    <div class="world__video">
      <Img src={img.patioCentral} alt="" sizes="100vw" widths={[768, 1280, 2000]} />
      <div class="world__video-in">
        <p class="world__did" aria-hidden="true">{d.world.did}</p>
        <button class="world__play" type="button" data-yt={site.videos.home} aria-label={d.world.play}><Icon name="play" size={30} /></button>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement2} mark="circle" /></div>
  </section>

  <!-- Por qué elegirnos -->
  <section class="section why">
    <div class="container">
      <h2 class="center" data-reveal>{d.why.title}</h2>
      <div class="why__grid">
        <Accordion idPrefix="why-a" items={d.why.items.slice(0, half).map((it, i) => ({ ...it, open: i === 0 }))} />
        <Accordion idPrefix="why-b" items={d.why.items.slice(half).map((it, i) => ({ ...it, open: i === 0 }))} />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><Statement {...d.statement3} /></div>
  </section>

  <!-- Certificaciones -->
  <section class="section certs">
    <div class="container grid-2">
      <div>
        <div class="certs__head" data-reveal>
          <span class="eyebrow">{d.certs.eyebrow}</span>
          <h2>{d.certs.title}</h2>
          <p class="lead">{d.certs.text}</p>
        </div>
        <ul class="certs__list" role="list">
          {d.certs.items.map((c, i) => (
            <li data-reveal style={`--d:${i * 60}ms`}>
              <span class="icon-badge"><Icon name={c.icon} /></span>
              <div><h3>{c.title}</h3><p>{c.text}</p></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="certs__media" data-reveal>
        <div class="certs__blob" aria-hidden="true"></div>
        <Img src={img.maestra} alt={d.certs.imgAlt} sizes="(min-width: 960px) 520px, 90vw" widths={[400, 800]} />
      </div>
    </div>
  </section>

  <!-- Niveles -->
  <section class="section levels">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{d.levels.title}</h2>
        <p>{d.levels.text}</p>
      </div>
      <div class="levels__grid">
        {[
          { ...d.levels.kinder, href: routes.kinder[lang], src: img.ninoKinder, tone: 'sage' },
          { ...d.levels.primary, href: routes.primary[lang], src: img.ninaPrimaria, tone: 'clay' },
        ].map((c, i) => (
          <a class:list={['level', `level--${c.tone}`]} href={c.href} data-reveal style={`--d:${i * 100}ms`}>
            <div class="level__copy">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <span class="btn btn-light btn-sm">{c.cta}<Icon name="arrow-up-right" /></span>
            </div>
            <Img src={c.src} alt={c.alt} class="level__img" sizes="(min-width: 960px) 260px, 45vw" widths={[300, 520]} />
            <svg class="level__spark" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c.6 6.5 5.5 11.4 12 12-6.5.6-11.4 5.5-12 12-.6-6.5-5.5-11.4-12-12C6.5 11.4 11.4 6.5 12 0z" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: var(--navy-800); }
  .hero :global(.hero__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(30 48 69 / 0.92) 0%, rgb(30 48 69 / 0.75) 45%, rgb(30 48 69 / 0.35) 100%); }
  .hero__in { display: grid; align-items: end; gap: 1rem; min-height: min(78vh, 720px); padding-top: clamp(3rem, 8vw, 6rem); }
  .hero__copy { align-self: center; max-width: 660px; padding-bottom: 2rem; }
  .hero h1 { color: #fff; font-size: clamp(2.3rem, 1.5rem + 3vw, 3.9rem); line-height: 1.05; letter-spacing: -0.025em; }
  .hero h1 span { display: block; }
  .js .hero h1 span { animation: rise 900ms var(--ease-out) both; }
  .js .hero h1 span:nth-child(2) { animation-delay: 90ms; }
  .js .hero h1 span:nth-child(3) { animation-delay: 180ms; }
  .hero__copy > p { margin-top: 1.5rem; font-size: var(--fs-lg); color: #dfe8f1; max-width: 46ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2.25rem; }
  .hero__play { display: inline-flex; align-items: center; gap: 0.75rem; color: #fff; font-weight: 600; }
  .hero__play-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.6); transition: background-color var(--dur-2), color var(--dur-2), transform var(--dur-1) var(--ease-out); }
  .hero__play:hover .hero__play-ic { background: #fff; color: var(--navy-800); }
  .hero__play:active .hero__play-ic { transform: scale(0.94); }
  .hero__kid { justify-self: center; width: min(78vw, 440px); }
  .hero__kid :global(img) { width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.25)); }
  @media (min-width: 960px) {
    .hero__in { grid-template-columns: 1.1fr 0.9fr; }
    .hero__kid { justify-self: end; margin-right: 2rem; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  @media (prefers-reduced-motion: reduce) { .js .hero h1 span { animation: none; } }

  /* Bienvenida */
  .welcome__media { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 0; min-height: 420px; }
  .welcome__dots { position: absolute; left: 0; top: 0; width: 45%; height: 40%; opacity: 0.7; }
  .welcome__a { grid-column: 1 / 3; grid-row: 1; width: 62%; margin-top: 15%; border-radius: 999px 999px var(--radius-lg) var(--radius-lg); aspect-ratio: 3 / 4; position: relative; z-index: 1; }
  .welcome__b { grid-column: 1 / 3; grid-row: 1; justify-self: end; width: 52%; aspect-ratio: 3 / 4.4; border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 999px; position: relative; z-index: 2; box-shadow: var(--shadow-lg); border: 6px solid #fff; }
  .welcome__cap { position: absolute; right: 4%; bottom: 0; width: 120px; z-index: 3; }
  .welcome__copy { display: grid; gap: 1.25rem; justify-items: start; }
  .welcome__copy h2 { font-size: var(--fs-3xl); }
  .welcome__intro { display: flex; gap: 1rem; align-items: flex-start; padding: 1.25rem; background: var(--paper-2); border-radius: var(--radius); }
  .welcome__intro img { flex: none; width: 40px; margin-top: 4px; }
  @media (max-width: 640px) { .welcome__intro { flex-direction: column; } }

  /* Cifras */
  .stats-wrap { padding-block: 1rem 3rem; }
  .stats {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; overflow: hidden; border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.12);
    background-color: var(--navy-700);
    background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.03) 0 2px, transparent 2px 22px);
    color: #fff;
  }
  .stats li { display: grid; justify-items: center; gap: 0.5rem; padding: 2rem 1rem; text-align: center; }
  .stats__ic { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: rgb(255 255 255 / 0.1); color: #cfe1ec; }
  .stats__label { font-size: var(--fs-sm); color: #d5e1ec; }
  .stats__num { color: #fff; font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  @media (min-width: 800px) { .stats { grid-template-columns: repeat(4, 1fr); } }

  /* El mundo cambió */
  .world__band { background: var(--navy-700); color: #fff; position: relative; overflow: hidden; }
  .world__band::before, .world__band::after { content: ''; position: absolute; top: 0; bottom: 0; width: 160px; background: repeating-linear-gradient(-55deg, rgb(255 255 255 / 0.07) 0 16px, transparent 16px 34px); }
  .world__band::before { left: 0; } .world__band::after { right: 0; transform: scaleX(-1); }
  .world__in { position: relative; z-index: 1; display: grid; gap: 2rem; align-items: center; padding-block: clamp(3rem, 6vw, 5rem); }
  .world h2 { color: #fff; font-size: var(--fs-3xl); max-width: 18ch; }
  .world__hl { position: relative; display: inline-block; }
  .world__hl svg { position: absolute; left: 0; bottom: -0.25em; width: 100%; height: 0.4em; }
  .world__hl path { fill: none; stroke: var(--sun-400); stroke-width: 5; stroke-linecap: round; }
  .world__channel { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1rem; border: 1px solid rgb(255 255 255 / 0.25); border-radius: var(--radius); max-width: 340px; transition: background-color var(--dur-2), border-color var(--dur-2); }
  .world__channel:hover { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.5); }
  .world__channel :global(img) { width: 76px; border-radius: 8px; }
  .world__channel span { font-weight: 600; }
  .world__arrow { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.4); transition: transform var(--dur-2) var(--ease-out); }
  .world__channel:hover .world__arrow { transform: rotate(45deg); }
  @media (min-width: 900px) { .world__in { grid-template-columns: 1fr auto; } }
  .world__video { position: relative; height: clamp(320px, 44vw, 640px); overflow: hidden; }
  .world__video :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .world__video-in { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(20 33 49 / 0.25); }
  .world__did { grid-area: 1 / 1; font-size: clamp(3rem, 2rem + 6vw, 7.5rem); font-weight: 800; color: rgb(255 255 255 / 0.55); text-transform: uppercase; letter-spacing: -0.02em; text-align: center; line-height: 0.95; max-width: 8ch; }
  .world__play { grid-area: 1 / 1; display: grid; place-items: center; width: 92px; height: 92px; border-radius: 50%; background: rgb(255 255 255 / 0.85); color: var(--navy-800); box-shadow: 0 0 0 12px rgb(255 255 255 / 0.25); transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-3) var(--ease-out); }
  .world__play:hover { transform: scale(1.06); box-shadow: 0 0 0 20px rgb(255 255 255 / 0.18); }
  .world__play:active { transform: scale(0.96); }

  /* Por qué elegirnos */
  .why h2 { margin-bottom: 2.5rem; }
  .why__grid { display: grid; gap: 0.75rem; }
  @media (min-width: 900px) { .why__grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }

  /* Certificaciones */
  .certs__head { display: grid; gap: 1rem; justify-items: start; }
  .certs__list { display: grid; gap: 1rem; margin-top: 2rem; }
  @media (min-width: 600px) { .certs__list { grid-template-columns: 1fr 1fr; } }
  .certs__list li { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem; border-radius: var(--radius); transition: background-color var(--dur-2); }
  .certs__list li:hover { background: var(--paper-2); }
  .certs__list h3 { font-size: var(--fs-sm); letter-spacing: 0.04em; }
  .certs__list p { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 0.2rem; }
  .certs__media { position: relative; display: grid; place-items: end center; }
  .certs__blob { position: absolute; inset: 12% 6% 0; border-radius: 48% 52% 40% 60% / 55% 45% 55% 45%; background: linear-gradient(140deg, var(--sky-100), var(--clay-100)); }
  .certs__media :global(img) { position: relative; width: min(100%, 460px); height: auto; }

  /* Niveles */
  .levels__grid { display: grid; gap: 1.5rem; max-width: 1000px; margin-inline: auto; }
  @media (min-width: 800px) { .levels__grid { grid-template-columns: 1fr 1fr; } }
  .level {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr auto; align-items: end; min-height: 300px;
    border-radius: var(--radius-lg); color: #fff; isolation: isolate;
    transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
  }
  .level::before { content: ''; position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px); background-size: 28px 28px; }
  .level--sage { background-color: var(--sage-400); }
  .level--clay { background-color: var(--clay-400); }
  .level__copy { align-self: center; padding: 2rem 0 2rem 2rem; display: grid; gap: 0.75rem; justify-items: start; }
  .level h3 { color: #fff; font-size: var(--fs-2xl); }
  .level p { color: rgb(255 255 255 / 0.92); }
  .level :global(.level__img) { width: clamp(150px, 18vw, 220px); height: auto; align-self: end; transition: transform var(--dur-3) var(--ease-out); transform-origin: bottom center; }
  .level__spark { position: absolute; top: 18px; right: 18px; width: 22px; color: #fff; }
  @media (hover: hover) and (pointer: fine) {
    .level:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .level:hover :global(.level__img) { transform: scale(1.04); }
  }
</style>

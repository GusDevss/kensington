---
import Base from '@/layouts/Base.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import { img } from '@/config/images';
import { t } from '@/i18n/ui';
import { routes, type Lang } from '@/i18n/routes';
import data from '@/data/profile';
import capDiploma from '@/assets/deco/birrete-diploma.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const ui = t(lang);
const stageImgs = [img.jardinJuegos, img.patioCentral];
const stageLinks = [routes.kinder[lang], routes.primary[lang]];
---
<Base lang={lang} routeKey="profile" title={d.meta.title} description={d.meta.description} image={img.patioCentral} crumbs={[{ name: ui.nav.profile, key: 'profile' }]}>
  <section class="section">
    <div class="container">
      <h1 class="center" data-reveal>{d.title}</h1>
      <div class="pf">
        {d.stages.map((s, i) => (
          <a class="stage" href={stageLinks[i]} data-reveal style={`--d:${i * 90}ms`}>
            <div class="stage__img">
              <Img src={stageImgs[i]} alt="" sizes="(min-width: 1024px) 340px, 90vw" widths={[400, 800]} />
              <span class="stage__plus"><Icon name="arrow-up-right" size={18} /></span>
            </div>
            <h2>{s.level}</h2>
            <p class="stage__path">{s.path.map((p, j) => <>{j > 0 && <Icon name="arrow-right" size={14} />}<span>{p}</span></>)}</p>
            <p class="stage__text">{s.text}</p>
          </a>
        ))}
        <div class="pf__people" data-reveal style="--d:180ms">
          <img src={capDiploma.src} alt="" width="120" height="69" class="pf__cap" loading="lazy" />
          <h2>{d.people.title}</h2>
          <p class="text-j">{d.people.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <h2 class="center" data-reveal>{d.graduates.title}</h2>
      <ul class="grads" role="list">
        {d.graduates.items.map((g, i) => (
          <li class="grad" data-reveal style={`--d:${(i % 3) * 70}ms`}>
            <div class="grad__head">
              <h3>{g.title}</h3>
              <span class="icon-badge"><Icon name={g.icon} /></span>
            </div>
            <p class="text-j">{g.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .pf { display: grid; gap: 1.5rem; margin-top: 3rem; align-items: stretch; }
  @media (min-width: 720px) { .pf { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .pf { grid-template-columns: 1fr 1fr 1.05fr; } }
  .stage { display: grid; align-content: start; gap: 0.6rem; text-align: center; }
  .stage__img { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 1rem; }
  .stage__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .stage:hover .stage__img :global(img) { transform: scale(1.05); }
  .stage__plus { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--navy-700); color: #fff; transition: transform var(--dur-2) var(--ease-out); }
  .stage:hover .stage__plus { transform: translateX(-50%) rotate(45deg); }
  .stage h2 { font-size: var(--fs-2xl); }
  .stage__path { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 0.4rem; font-size: var(--fs-lg); font-weight: 600; color: var(--ink); }
  .stage__path :global(svg) { color: var(--accent); }
  .stage__text { font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.03em; font-weight: 600; color: var(--navy-600); max-width: 34ch; margin-inline: auto; }
  .pf__people { position: relative; display: grid; align-content: center; gap: 1rem; padding: 2rem; border: 2px solid var(--navy-800); border-radius: var(--radius-xl); }
  @media (min-width: 720px) and (max-width: 1099px) { .pf__people { grid-column: 1 / -1; } }
  .pf__people h2 { font-size: var(--fs-xl); color: var(--navy-800); padding-right: 3rem; }
  .pf__people p { font-size: var(--fs-sm); }
  .pf__cap { position: absolute; right: -14px; top: -34px; width: 96px; transform: rotate(8deg); }

  .grads { display: grid; gap: 1.25rem; margin-top: 3rem; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .grad { display: grid; align-content: start; gap: 1rem; padding: 1.75rem; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); transition: border-color var(--dur-2), box-shadow var(--dur-3), transform var(--dur-3) var(--ease-out); }
  .grad:hover { border-color: var(--sky-300); box-shadow: var(--shadow); transform: translateY(-3px); }
  .grad__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .grad h3 { font-size: var(--fs-lg); line-height: 1.3; }
  .grad p { font-size: var(--fs-sm); color: var(--ink-2); }
</style>

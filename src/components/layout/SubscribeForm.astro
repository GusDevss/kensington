---
import type { Lang } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
interface Props { lang: Lang; id: string; dark?: boolean }
const { lang, id, dark = false } = Astro.props;
const ui = t(lang);
---
<form class:list={['sub', { 'sub--dark': dark }]} action={site.formEndpoint} method="post" data-ajax-form data-success={ui.subscribeOk} data-error={`${ui.formError} ${site.email}`}>
  <input type="hidden" name="type" value="subscribe" />
  <input type="hidden" name="lang" value={lang} />
  <label class="visually-hidden" for={id}>{ui.subscribePlaceholder}</label>
  <div class="hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
  <div class="sub__row">
    <input id={id} type="email" name="email" required autocomplete="email" placeholder={ui.subscribePlaceholder} />
    <button type="submit" aria-label={ui.subscribe}><Icon name="arrow-up-right" size={20} /></button>
  </div>
  <p class="sub__msg" role="status" aria-live="polite"></p>
</form>
<style>
  .sub__row { display: flex; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; transition: border-color var(--dur-2), box-shadow var(--dur-2); }
  .sub__row:focus-within { border-color: var(--navy-600); box-shadow: 0 0 0 4px var(--sky-100); }
  .sub input[type='email'] { flex: 1; min-width: 0; border: 0; padding: 0.9rem 1rem; background: transparent; outline: none; }
  .sub button { display: grid; place-items: center; width: 56px; border-left: 1px solid var(--line); color: var(--navy-800); transition: background-color var(--dur-2), color var(--dur-2); }
  .sub button:hover { background: var(--navy-700); color: #fff; }
  .sub__msg { font-size: var(--fs-xs); margin-top: 0.5rem; min-height: 1.2em; }
  .sub__msg.is-ok { color: var(--teal-500); }
  .sub__msg.is-err { color: #b42318; }
  .sub--dark .sub__row { background: rgb(255 255 255 / 0.06); border-color: rgb(255 255 255 / 0.15); }
  .sub--dark input[type='email'] { color: #fff; }
  .sub--dark input::placeholder { color: rgb(255 255 255 / 0.6); }
  .sub--dark button { color: #fff; border-color: rgb(255 255 255 / 0.15); }
  .sub--dark button:hover { background: #fff; color: var(--navy-800); }
  .sub--dark .sub__msg.is-ok { color: #7fe0c8; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

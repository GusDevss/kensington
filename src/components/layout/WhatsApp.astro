---
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const msg = es ? 'Hola, me gustaría recibir información sobre Kensington Academy.' : 'Hello, I would like to receive information about Kensington Academy.';
const label = es ? '¿Dudas? Escríbenos' : 'Questions? Message us';
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(msg)}`;
---
<a class="wa" href={href} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${site.phone} — ${label}`}>
  <span class="wa__tip" aria-hidden="true">{label}</span>
  <span class="wa__btn"><Icon name="brand-whatsapp" size={30} /></span>
</a>

<style>
  .wa { position: fixed; right: clamp(1rem, 2.5vw, 1.75rem); bottom: calc(clamp(1rem, 2.5vw, 1.75rem) + env(safe-area-inset-bottom)); z-index: 60; display: flex; align-items: center; gap: 0.75rem; }
  .wa__btn { position: relative; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: #25d366; color: #fff; box-shadow: 0 10px 28px -8px rgb(18 140 70 / 0.7); transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2); }
  .wa__btn::before { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25d366; animation: waPulse 2.6s var(--ease-out) infinite; }
  @keyframes waPulse { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.6); opacity: 0; } }
  .wa:hover .wa__btn { transform: scale(1.06); box-shadow: 0 14px 32px -8px rgb(18 140 70 / 0.8); }
  .wa:active .wa__btn { transform: scale(0.95); }
  .wa__tip { padding: 0.55rem 0.9rem; border-radius: 999px; background: #fff; color: var(--navy-900); font-weight: 600; font-size: var(--fs-xs); white-space: nowrap; box-shadow: var(--shadow); opacity: 0; transform: translateX(8px); pointer-events: none; transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .wa:hover .wa__tip, .wa:focus-visible .wa__tip { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .wa__btn::before { animation: none; } }
  @media print { .wa { display: none; } }
</style>

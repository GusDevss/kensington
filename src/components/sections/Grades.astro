---
import type { ImageMetadata } from 'astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
interface Grade { quote: string; badge: string; text: string; img: ImageMetadata; alt: string }
interface Props { items: Grade[]; prev: string; next: string; label: string }
const { items, prev, next, label } = Astro.props;
---
<div class="grades" data-carousel aria-roledescription="carousel" aria-label={label}>
  <ul class="grades__track" role="list" data-track>
    {items.map((g, i) => (
      <li class="grade" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`}>
        <div class="grade__img"><Img src={g.img} alt={g.alt} sizes="(min-width: 1100px) 280px, 75vw" widths={[360, 640]} /></div>
        <div class="grade__body">
          <h3>{g.quote}</h3>
          <span class="grade__badge">{g.badge}</span>
          <p>{g.text}</p>
        </div>
      </li>
    ))}
  </ul>
  <div class="grades__nav">
    <button class="icon-btn" type="button" data-prev aria-label={prev}><Icon name="arrow-left" /></button>
    <span class="grades__count" data-counter aria-hidden="true"></span>
    <button class="icon-btn" type="button" data-next aria-label={next}><Icon name="arrow-right" /></button>
  </div>
</div>
<style>
  .grades__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: min(78%, 290px); gap: 1.25rem;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 4px; padding: 0.5rem 4px 1.5rem;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .grades__track::-webkit-scrollbar { display: none; }
  @media (min-width: 1100px) { .grades__track { grid-auto-columns: calc((100% - 3 * 1.25rem) / 4); } }
  .grade { scroll-snap-align: start; display: flex; flex-direction: column; background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--line); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .grade:hover { transform: translateY(-4px); box-shadow: var(--shadow); } }
  .grade__img { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 0 0 50% 50% / 0 0 18% 18%; }
  .grade__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .grade__body { display: grid; justify-items: center; gap: 0.75rem; text-align: center; padding: 1.25rem 1.25rem 1.75rem; }
  .grade h3 { font-size: 1.05rem; line-height: 1.35; }
  .grade__badge { display: inline-block; padding: 0.3rem 0.9rem; border-radius: 999px; background: var(--navy-700); color: #fff; font-size: var(--fs-xs); font-weight: 600; }
  .grade p { font-size: var(--fs-sm); color: var(--ink-3); }
  .grades__nav { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 0.5rem; }
  .grades__nav button:disabled { opacity: 0.35; pointer-events: none; }
  .grades__count { min-width: 3.5em; text-align: center; font-variant-numeric: tabular-nums; font-weight: 600; color: var(--navy-700); }
</style>

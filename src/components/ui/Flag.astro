---
interface Props { code: 'es' | 'en'; size?: number }
const { code, size = 20 } = Astro.props;
---
<span class="flag" style={`--s:${size}px`} aria-hidden="true">
  {code === 'es' ? (
    <svg viewBox="0 0 30 30"><g><path fill="#006847" d="M0 0h10v30H0z" /><path fill="#fff" d="M10 0h10v30H10z" /><path fill="#ce1126" d="M20 0h10v30H20z" /><circle cx="15" cy="15" r="2.6" fill="#8c6a2f" /></g></svg>
  ) : (
    <svg viewBox="0 0 30 30"><g><path fill="#fff" d="M0 0h30v30H0z" /><path fill="#b22234" d="M0 0h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0z" /><path fill="#3c3b6e" d="M0 0h14v16.1H0z" /></g></svg>
  )}
</span>
<style>
  .flag { display: inline-block; width: var(--s); height: var(--s); flex: none; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.6); }
  .flag svg { width: 100%; height: 100%; }
</style>

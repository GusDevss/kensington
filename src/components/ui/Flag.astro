---
/** Banderas circulares en SVG (sin dependencias). */
export type FlagCode = 'es' | 'en' | 'ar' | 'zh-CN' | 'nl' | 'fr' | 'de' | 'it' | 'ja' | 'pt' | 'ru';
interface Props { code: FlagCode; size?: number }
const { code, size = 20 } = Astro.props;

const star = (cx: number, cy: number, r: number, rot = 0) => {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const rad = ((i * 36 + rot - 90) * Math.PI) / 180;
    const rr = i % 2 === 0 ? r : r * 0.4;
    pts.push(`${(cx + rr * Math.cos(rad)).toFixed(2)},${(cy + rr * Math.sin(rad)).toFixed(2)}`);
  }
  return pts.join(' ');
};
const h3 = (a: string, b: string, c: string) => `<path fill="${a}" d="M0 0h30v10H0z"/><path fill="${b}" d="M0 10h30v10H0z"/><path fill="${c}" d="M0 20h30v10H0z"/>`;
const v3 = (a: string, b: string, c: string) => `<path fill="${a}" d="M0 0h10v30H0z"/><path fill="${b}" d="M10 0h10v30H10z"/><path fill="${c}" d="M20 0h10v30H20z"/>`;
const svgs: Record<FlagCode, string> = {
  es: `${v3('#006847', '#fff', '#ce1126')}<circle cx="15" cy="15" r="2.6" fill="#8c6a2f"/>`,
  en: `<path fill="#fff" d="M0 0h30v30H0z"/><path fill="#b22234" d="M0 0h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0zm0 4.6h30v2.3H0z"/><path fill="#3c3b6e" d="M0 0h14v16.1H0z"/>`,
  ar: `<path fill="#006c35" d="M0 0h30v30H0z"/><path fill="#fff" d="M7 11.5h16v1.6H7zM8 9h3v1.2H8zm5 0h4v1.2h-4zm6 0h3v1.2h-3zM7.5 18.5h15l1.5-.8v1.8H7.5z"/>`,
  'zh-CN': `<path fill="#de2910" d="M0 0h30v30H0z"/><polygon fill="#ffde00" points="${star(9, 10, 4.5)}"/><polygon fill="#ffde00" points="${star(15, 5.5, 1.4, 20)}"/><polygon fill="#ffde00" points="${star(17.5, 8.5, 1.4, 45)}"/><polygon fill="#ffde00" points="${star(17.5, 12.5, 1.4, 0)}"/><polygon fill="#ffde00" points="${star(15, 15.5, 1.4, 20)}"/>`,
  nl: h3('#ae1c28', '#fff', '#21468b'),
  fr: v3('#002395', '#fff', '#ed2939'),
  de: h3('#000', '#dd0000', '#ffce00'),
  it: v3('#009246', '#fff', '#ce2b37'),
  ja: `<path fill="#fff" d="M0 0h30v30H0z"/><circle cx="15" cy="15" r="6.5" fill="#bc002d"/>`,
  pt: `<path fill="#da291c" d="M0 0h30v30H0z"/><path fill="#046a38" d="M0 0h12v30H0z"/><circle cx="12" cy="15" r="5" fill="#ffe900"/><circle cx="12" cy="15" r="3" fill="#da291c"/>`,
  ru: h3('#fff', '#0039a6', '#d52b1e'),
};
---
<span class="flag" style={`--s:${size}px`} aria-hidden="true"><svg viewBox="0 0 30 30" set:html={svgs[code]} /></span>
<style>
  .flag { display: inline-block; width: var(--s); height: var(--s); flex: none; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.6), inset 0 0 0 1px rgb(0 0 0 / 0.08); }
  .flag svg { width: 100%; height: 100%; }
</style>
